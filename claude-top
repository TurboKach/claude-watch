#!/usr/bin/env bash
# claude-top — live process tree and resource usage for Claude Code sessions.
#
# A Claude Code session spawns shells, MCP servers, dev servers, test runners
# and headless browsers as descendants of itself. Activity Monitor lists those
# as unrelated "node" / "chrome-headless-shell" rows, so a session pinning
# several cores looks like nothing in particular is running. This rolls each
# session's whole subtree into one number, and flags dev processes that
# outlived the session that started them.

set -u

interval=2
once=0
orphan_min=60

usage() {
  cat <<'EOF'
claude-top — live process tree + resource usage for Claude Code sessions

usage: claude-top [-i SECS] [-o MINS] [-1] [-h]

  -i SECS   refresh interval (default: 2)
  -o MINS   flag unparented dev processes older than MINS (default: 60)
  -1        print one frame and exit (pipe-friendly, no ANSI clearing)
  -h        this help

CPU is percent of ONE core, as in top(1): 250% means two and a half cores.
Session rows show the subtree total, so a session's cost is a single number.
EOF
}

while getopts ':i:o:1h' opt; do
  case "$opt" in
    i) interval=$OPTARG ;;
    o) orphan_min=$OPTARG ;;
    1) once=1 ;;
    h) usage; exit 0 ;;
    *) usage >&2; exit 2 ;;
  esac
done

case "$interval$orphan_min" in *[!0-9.]*) echo "claude-top: -i and -o take numbers" >&2; exit 2 ;; esac

# --- session metadata (cwd + tab label), cached: neither changes for a live pid ---
declare -A CWD_OF LABEL_OF

# Claude keeps no open handle on its transcript, so a pid cannot be mapped to a
# session id directly. Instead: cwd -> project slug -> the one transcript in
# that project written to recently. Ambiguous cases (two sessions sharing a cwd,
# or none recently active) resolve to no label rather than a wrong one.
resolve_meta() {
  local pid=$1 cwd=$2 slug proj hits id
  CWD_OF[$pid]=$cwd
  LABEL_OF[$pid]=""
  slug=$(printf '%s' "$cwd" | sed 's/[^A-Za-z0-9]/-/g')
  proj="$HOME/.claude/projects/$slug"
  [ -d "$proj" ] || return 0
  hits=$(find "$proj" -maxdepth 1 -name '*.jsonl' -mmin -3 2>/dev/null)
  [ "$(printf '%s\n' "$hits" | grep -c .)" -eq 1 ] || return 0
  id=$(basename "$hits" .jsonl)
  LABEL_OF[$pid]=$(head -n1 "$HOME/.claude/session-labels/$id.txt" 2>/dev/null \
                   | LC_ALL=C tr -d '\000-\037\177')
}

# lsof only for pids we have not seen yet, so steady-state frames cost nothing.
refresh_meta() {
  local roots=$1 want=() p
  for p in $roots; do [ -n "${CWD_OF[$p]+x}" ] || want+=("$p"); done
  [ ${#want[@]} -eq 0 ] && return 0
  local list cur=""
  list=$(IFS=,; printf '%s' "${want[*]}")
  while IFS= read -r line; do
    case "$line" in
      p*) cur=${line#p} ;;
      n/*) [ -n "$cur" ] && { resolve_meta "$cur" "${line#n}"; cur=""; } ;;
    esac
  done < <(lsof -a -d cwd -p "$list" -Fn 2>/dev/null)
  for p in "${want[@]}"; do [ -n "${CWD_OF[$p]+x}" ] || { CWD_OF[$p]="?"; LABEL_OF[$p]=""; }; done
}

# --- system header ---
# Mirrors Activity Monitor's "Memory Used" = app + wired + compressed. vm_stat
# costs ~5ms; `top -l 1` gives the same number but takes ~280ms per frame, which
# is real load to add to a tool whose job is diagnosing load.
sys_header() {
  local ncpu load pagesize
  ncpu=$(sysctl -n hw.ncpu)
  load=$(sysctl -n vm.loadavg | awk '{print $2}')
  pagesize=$(sysctl -n hw.pagesize)
  sysctl -n hw.memsize vm.swapusage | tr '\n' ' ' > /dev/null
  vm_stat | awk -v ps="$pagesize" -v total="$(sysctl -n hw.memsize)" \
                -v swap="$(sysctl -n vm.swapusage)" -v load="$load" -v ncpu="$ncpu" '
    /Anonymous pages/            { anon = $3 }
    /Pages wired down/           { wired = $4 }
    /Pages occupied by compressor/ { comp = $5 }
    /Pages purgeable/            { purge = $3 }
    /Pages free/                 { free = $3 }
    /Pages speculative/          { spec = $3 }
    END {
      gsub(/\./, "", anon); gsub(/\./, "", wired); gsub(/\./, "", comp)
      gsub(/\./, "", purge); gsub(/\./, "", free); gsub(/\./, "", spec)
      used = (anon - purge + wired + comp) * ps
      avail = (free + spec) * ps
      split(swap, s, /[ =M]+/)
      for (i = 1; i <= 20; i++) if (s[i] == "used") { swu = s[i+1]; break }
      printf "%s\x1f%s\x1f%.1f\x1f%.1f\x1f%.1f\x1f%s\n",
             ncpu, load, used/1073741824, total/1073741824, avail/1073741824, swu+0
    }'
}

# --- one frame ---
frame() {
  local cols=$1 roots snap
  snap=$(ps -Ao pid=,ppid=,pcpu=,rss=,etime=,args=)

  # $6 is the first token of the command line: ps right-pads the numeric columns,
  # so anything that counts leading characters misses sessions whose pid is
  # narrower than the widest pid on the machine.
  roots=$(printf '%s\n' "$snap" | awk '{ n = $6; sub(/.*\//, "", n); if (n == "claude") print $1 }')
  [ -n "$roots" ] && refresh_meta "$roots"

  local metafile snapfile
  metafile=$(mktemp); snapfile=$(mktemp)
  printf '%s\n' "$snap" > "$snapfile"
  local p
  for p in $roots; do
    printf '%s\x1f%s\x1f%s\n' "$p" "${CWD_OF[$p]:-?}" "${LABEL_OF[$p]:-}" >> "$metafile"
  done

  # LC_ALL=C keeps awk byte-oriented, which is what makes the CONT byte class
  # below legal; this awk (20200816) errors on it in a UTF-8 locale and still
  # cannot measure multi-byte glyphs, so we count characters by hand instead.
  sys_header | LC_ALL=C awk -v W="$cols" -v OM="$orphan_min" -v META="$metafile" \
                   -v SNAP="$snapfile" -v NOW="$(date +%H:%M:%S)" '
  function esec(e,   a, b, d, n, h, m) {
    d = 0
    if (e ~ /-/) { split(e, a, "-"); d = a[1]; e = a[2] }
    n = split(e, b, ":")
    if (n == 3) { h = b[1]; m = b[2] } else { h = 0; m = b[1]; b[3] = b[2] }
    return d * 86400 + h * 3600 + m * 60 + b[3]
  }
  function age(s,   d, h, m) {
    d = int(s / 86400); h = int((s % 86400) / 3600); m = int((s % 3600) / 60)
    if (d) return sprintf("%dd%02dh", d, h)
    if (h) return sprintf("%dh%02dm", h, m)
    return sprintf("%dm", m)
  }
  function mem(kb) {
    if (kb >= 1048576) return sprintf("%.1fG", kb / 1048576)
    return sprintf("%dM", int(kb / 1024))
  }
  # Trim the leading token(s) of a command line down to a readable name, then
  # add the one detail that says what it is actually doing.
  function label(a,   n, t, i, w, nw, parts, extra) {
    extra = ""
    if (a ~ /\.app\/Contents\/MacOS\//) { n = a; sub(/.*\/Contents\/MacOS\//, "", n); sub(/ -.*/, "", n) }
    else { n = a; sub(/ .*/, "", n); sub(/.*\//, "", n) }
    # ps parenthesises the accounting name when a process argument vector cannot
    # be read — routine for short-lived processes caught mid-exec or exiting.
    if (n ~ /^\(.*\)$/) { sub(/^\(/, "", n); sub(/\)$/, "", n) }
    if (n ~ /^chrome-headless/) n = "chrome-headless"
    if (a ~ /(-mcp|mcp-server|modelcontextprotocol)/) {
      nw = split(a, parts, /[ \/]+/)
      for (i = nw; i >= 1; i--) if (parts[i] ~ /mcp/) { return "mcp " parts[i] }
    }
    if (a ~ / --test( |$)/) extra = " --test"
    if (n ~ /^(node|tsx|bun|deno|python3?|ruby)$/) {
      nw = split(a, parts, " ")
      for (i = 2; i <= nw; i++) {
        w = parts[i]
        if (w ~ /^-/) continue
        if (w ~ /\.(ts|js|mjs|cjs|py|rb)$/ || w ~ /node_modules\/\.bin\//) {
          sub(/.*\//, "", w); extra = " " w extra; break
        }
      }
    }
    return n extra
  }
  function cpucol(c) {
    if (c >= 200) return "\033[38;5;196m"
    if (c >= 100) return "\033[38;5;208m"
    if (c >= 25)  return "\033[38;5;226m"
    if (c >= 1)   return "\033[38;5;46m"
    return "\033[38;5;245m"
  }
  # One cell per quarter-core, so the bar only appears once a process is doing
  # enough work to be worth noticing.
  function bar(c,   k, s) {
    k = int(c / 25); if (k > 10) k = 10
    if (k < 1) return ""
    s = " " cpucol(c); while (k-- > 0) s = s "█"
    return s "\033[0m"
  }
  # Walk a string one display cell at a time: colour escapes are copied but cost
  # nothing, and a multi-byte glyph (box-drawing, an emoji in a tab title) is one
  # cell however many bytes it takes. Used for both measuring and truncating, so
  # a cut can never land inside an escape sequence or halfway through a glyph.
  function cells(s,   n, i, j, w) {
    n = length(s); i = 1; w = 0
    while (i <= n) {
      if (substr(s, i, 1) == "\033") {
        j = i + 1
        while (j <= n && substr(s, j, 1) !~ /[A-Za-z]/) j++
        i = j + 1; continue
      }
      j = i + 1
      while (j <= n && substr(s, j, 1) ~ CONT) j++
      w++; i = j
    }
    return w
  }
  function trunc(s, max,   n, i, j, w, out) {
    n = length(s); i = 1; w = 0; out = ""
    while (i <= n) {
      if (substr(s, i, 1) == "\033") {
        j = i + 1
        while (j <= n && substr(s, j, 1) !~ /[A-Za-z]/) j++
        out = out substr(s, i, j - i + 1); i = j + 1; continue
      }
      if (w >= max) return out "…\033[0m"
      j = i + 1
      while (j <= n && substr(s, j, 1) ~ CONT) j++
      out = out substr(s, i, j - i); w++; i = j
    }
    return out
  }
  function row(left, c, kb, dim,   pad, right, w) {
    right = sprintf("%s%7.1f%%\033[0m %s%6s\033[0m", cpucol(c), c, dim ? "\033[38;5;245m" : "", mem(kb))
    w = W - cells(right) - 1
    if (cells(left) > w) left = trunc(left, w - 1)
    pad = w - cells(left)
    if (pad < 1) pad = 1
    printf "%s%*s%s\n", left, pad, "", right
  }
  function subcpu(p,   i, s) { s = cpu[p]; for (i = 1; i <= nk[p]; i++) s += subcpu(kid[p, i]); return s }
  function subrss(p,   i, s) { s = rss[p]; for (i = 1; i <= nk[p]; i++) s += subrss(kid[p, i]); return s }
  function walk(p, pre, last,   i, br, nxt, lab) {
    lab = label(args[p])
    br = last ? "└─ " : "├─ "
    nxt = pre (last ? "   " : "│  ")
    row(sprintf("  \033[38;5;238m%s%s\033[0m\033[38;5;252m%s\033[0m \033[38;5;238m%s\033[0m%s",
                pre, br, lab, p, bar(cpu[p])), cpu[p], rss[p], 1)
    for (i = 1; i <= nk[p]; i++) walk(kid[p, i], nxt, i == nk[p])
  }

  BEGIN {
    CONT = "[\200-\277]"   # UTF-8 continuation bytes: never a cell of their own
    grey = "\033[38;5;245m"; dim = "\033[38;5;238m"; cyan = "\033[38;5;51m"
    red = "\033[38;5;196m"; yellow = "\033[38;5;226m"; green = "\033[38;5;46m"
    orange = "\033[38;5;208m"; rst = "\033[0m"

    while ((getline line < META) > 0) {
      split(line, mt, "\x1f"); isroot[mt[1]] = 1; cwd[mt[1]] = mt[2]; tab[mt[1]] = mt[3]
    }
    close(META)

    while ((getline line < SNAP) > 0) {
      if (line == "") continue
      split(line, f, " ")
      p = f[1]; a = line
      for (i = 1; i <= 5; i++) sub(/^ *[^ ]+ +/, "", a)
      par[p] = f[2]; cpu[p] = f[3]; rss[p] = f[4]
      secs[p] = esec(f[5]); args[p] = a; seen[p] = 1
      if (p != 1) { nk[f[2]]++; kid[f[2], nk[f[2]]] = p }
    }
    close(SNAP)
    # Mark every descendant of a session so the "hot elsewhere" line and the
    # orphan scan can exclude what the tree already accounts for.
    for (p in isroot) mark(p)
  }
  function mark(p,   i) { inclaude[p] = 1; for (i = 1; i <= nk[p]; i++) mark(kid[p, i]) }

  {
    split($0, h, "\x1f")
    ncpu = h[1]; load = h[2]; used = h[3]; total = h[4]; avail = h[5]; swap = h[6]

    lcol = (load > ncpu) ? red : (load > ncpu * 0.6) ? yellow : green
    mcol = (avail < 1.0) ? red : (avail < 3.0) ? yellow : green
    scol = (swap > 1024) ? red : (swap > 0) ? yellow : grey

    printf "\033[1;38;5;51mclaude-top\033[0m  %s%d cores · load %.2f%s  %s%s\n",
           lcol, ncpu, load, rst, grey NOW, rst
    printf "  %smem %.1fG/%.0fG used · %.1fG free%s  %sswap %dM%s\n",
           mcol, used, total, avail, rst, scol, swap, rst

    # Sessions, hottest first.
    nr = 0
    for (p in isroot) { rs[++nr] = p; rc[p] = subcpu(p) }
    for (i = 1; i < nr; i++) for (k = i + 1; k <= nr; k++)
      if (rc[rs[k]] > rc[rs[i]]) { t = rs[i]; rs[i] = rs[k]; rs[k] = t }

    if (nr == 0) printf "\n  %sno Claude Code sessions running%s\n", grey, rst
    tot = 0; totm = 0
    for (i = 1; i <= nr; i++) {
      p = rs[i]
      c = rc[p]; mtot = subrss(p); tot += c; totm += mtot
      d = cwd[p]; sub(ENVIRON["HOME"], "~", d)
      head = sprintf(" \033[38;5;51m⏺\033[0m \033[1mclaude%s %s%s%s  %s%s%s",
                     rst, dim, p, rst, orange, d, rst)
      if (tab[p] != "") head = head sprintf("  %s%s%s", grey, tab[p], rst)
      printf "\n"
      row(head, c, mtot, 0)
      for (k = 1; k <= nk[p]; k++) walk(kid[p, k], "", k == nk[p])
    }
    if (nr > 1) {
      rule = ""; for (i = 0; i < W - 2; i++) rule = rule "─"
      printf "  %s%s%s\n", dim, rule, rst
      row(sprintf("  %sall sessions%s", grey, rst), tot, totm, 0)
    }

    # Everything hot that is NOT a Claude descendant — the steady background
    # burn that makes the fans spin even when no session is busy.
    nh = 0
    for (p in seen) if (!inclaude[p] && cpu[p] >= 5 && p != 0) hp[++nh] = p
    for (i = 1; i < nh; i++) for (k = i + 1; k <= nh; k++)
      if (cpu[hp[k]] > cpu[hp[i]]) { t = hp[i]; hp[i] = hp[k]; hp[k] = t }
    if (nh > 0) {
      printf "\n %shot elsewhere%s\n", grey, rst
      for (i = 1; i <= nh && i <= 5; i++) {
        p = hp[i]
        row(sprintf("  %s%s%s %s%s%s", "\033[38;5;252m", label(args[p]), rst, dim, p, rst),
            cpu[p], rss[p], 1)
      }
    }

    # Dev processes reparented to launchd: whatever started them is gone, but
    # they still hold memory, ports and file handles.
    no = 0
    for (p in seen) {
      if (par[p] != 1 || inclaude[p]) continue
      if (secs[p] < OM * 60) continue
      if (args[p] !~ /(node|tsx|npm|npx|yarn|pnpm|bun|deno|vite|esbuild|webpack|jest|vitest|pytest|python[23]?|ts-node|next-server|playwright|chrome-headless)/) continue
      if (args[p] ~ /(Applications|\/usr\/libexec|\/System\/)/) continue
      op[++no] = p
    }
    if (no > 0) {
      printf "\n %s⚠ orphaned dev processes%s %s(no parent, older than %d min)%s\n", red, rst, grey, OM, rst
      for (i = 1; i <= no; i++) {
        p = op[i]
        row(sprintf("  %s%s%s %s%s · %s%s", yellow, label(args[p]), rst, dim, p, age(secs[p]), rst),
            subcpu(p), subrss(p), 1)
      }
    }
  }'
  rm -f "$metafile" "$snapfile"
}

if [ "$once" -eq 1 ]; then
  frame "$(tput cols 2>/dev/null || echo 100)"
  exit 0
fi

printf '\033[?25l'
trap 'printf "\033[?25h\033[0m\n"; exit 0' INT TERM EXIT

while :; do
  out=$(frame "$(tput cols 2>/dev/null || echo 100)")
  # Repaint over the previous frame instead of clearing it: no flicker, and the
  # rows stay readable while they update.
  printf '\033[H'
  printf '%s\n' "$out" | while IFS= read -r l; do printf '%s\033[K\n' "$l"; done
  printf '\033[J'
  sleep "$interval"
done
